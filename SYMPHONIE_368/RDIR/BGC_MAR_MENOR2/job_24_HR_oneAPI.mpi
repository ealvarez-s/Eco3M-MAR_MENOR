#!/bin/bash
#SBATCH -J Eco3M_hr
#SBATCH -N 1
#SBATCH --nodelist=c01
#SBATCH --partition=hpc
#SBATCH --time=2-12:00:00
####SBATCH --time=2-01:00:00
####SBATCH -t 1-00:00:00
#SBATCH --ntasks=12
####SBATCH --ntasks-per-node=48
####SBATCH --ntasks-per-core=1


#### echo Bonjour du noeud `hostname`
rm fort*
rm tmp/*
export SLURM_CONF=/home/alvarez/slurm.conf

#### module purge
#### module load intel/18.2 intelmpi/18.2 hdf5/1.10.2-intelmpi netcdf/4.6.1-intelmpi pnetcdf/1.9.0-intelmpi
source ~/intel/oneapi/setvars.sh --force
export OMPI_FC=ifort
export OMPI_CC=icx
export OMP_CXX=icpx

export PNETCDF_DIR=$HOME/local/pnetcdf-1.12.3
export HDF5_DIR=$HOME/local/hdf5-1.12.1
export NETCDF_DIR=$HOME/local/netcdf-c-4.9.2
export NETCDF_FORTRAN_DIR=$HOME/local/netcdf-fortran-4.6.1
export PATH=$PNETCDF_DIR/bin:$HDF5_DIR/bin:$NETCDF_DIR/bin:$NETCDF_FORTRAN_DIR/bin:$PATH
export LD_LIBRARY_PATH=$PNETCDF_DIR/lib:$HDF5_DIR/lib:$NETCDF_DIR/lib:$NETCDF_FORTRAN_DIR/lib:$LD_LIBRARY_PATH
export CPATH=$PNETCDF_DIR/include:$HDF5_DIR/include:$NETCDF_DIR/include:$NETCDF_FORTRAN_DIR/include:$CPATH

date
export I_MPI_DEBUG=0
mpiexec.hydra -n 12 ./S26.exe    ## NTasks=1
##mpirun -np 23 ./S26.exe          ## NTasks=1   ## linked to mpiexec.hydra
date

