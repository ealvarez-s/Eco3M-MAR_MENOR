#!/bin/bash
#SBATCH -J Eco3M_hr
#SBATCH -N 2
#SBATCH --nodelist=c01,c02
#SBATCH --partition=hpc
####SBATCH --time=7-00:00:00
#SBATCH --time=04:00:00
####SBATCH -t 1-00:00:00
#SBATCH --ntasks=95
####SBATCH --ntasks-per-node=48
####SBATCH --ntasks-per-core=1

#### echo Bonjour du noeud `hostname`
rm fort*
rm tmp/*
export SLURM_CONF=/home/alvarez/slurm.conf

echo "Job ID: ${SLURM_JOB_ID}"
echo "Local ID: ${SLURM_LOCALID}"
echo "NodeList: ${SLURM_JOB_NODELIST}"
echo "Tareas: ${SLURM_NTASKS}"
echo "Tareas/nodo: ${SLURM_TASKS_PER_NODE}"
echo "SubmitDir: ${SLURM_SUBMIT_DIR}"
echo "SubmitHost: ${SLURM_SUBMIT_HOST}"
echo "Conf.file: ${SLURM_CONF}"
echo "Mem x CPU: ${SLURM_MEM_PER_CPU}"

#### module purge
#### module load intel/18.2 intelmpi/18.2 hdf5/1.10.2-intelmpi netcdf/4.6.1-intelmpi pnetcdf/1.9.0-intelmpi
conda activate belich-legos-r
export LD_LIBRARY_PATH=/home/alvarez/miniconda3/envs/belich-legos-r/lib:$LD_LIBRARY_PATH
source /home/alvarez/intel/oneapi/mpi/2021.13/env/vars.sh --force
echo "LD_LIBRARY_PATH después de cargar Intel MPI: $LD_LIBRARY_PATH"

##export OMPI_FC=ifort
##export OMPI_CC=icc
##export OMP_CXX=icpc

#### module list 2> currently_loaded_modulefile
export I_MPI_PIN=1
export I_MPI_DEBUG=5
#export FI_PROVIDER=tcp
export FI_PROVIDER=shm:ofi
export I_MPI_FABRICS=shm  # O prueba con shm si tcp es lento
export OMP_NUM_THREADS=1

#export I_MPI_JOB_WAIT=1
#export I_MPI_ADJUST_ALLREDUCE=2
#export I_MPI_ADJUST_BCAST=2

## mpiexec.hydra -n 95 ./S26.exe
##srun -n 95 ./S26.exe
##mpirun -np 95 ./S26.exe

##mpirun -np 95 hostname >> slurm-95MPI.out
##mpirun -np 95 taskset -pc $$ >> slurm-95MPIbalance.out
##iostat -xm 1 10 >> slurm-95IOstat.out

mpirun -np 95 ./S26.exe
##srun --mpi=pmi2 -n 95 ./S26.exe
##srun --mpi=pmix -n 95 ./S26.exe

## Monitorizar estado
## scontrol show job <job_id>
## sstat -j <job_id> --format=JobID,NTasks,AveCPU,AveRSS,MaxRSS

